---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { blogPosts, type BlogBlock } from '../../data/blogPosts';

export function getStaticPaths() {
	return blogPosts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const otherPosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 5);

function renderBlock(block: BlogBlock) {
	return block;
}

// Pecah teks menjadi bagian-bagian: kemunculan "bayarfidyah.com" ditandai agar
// bisa dirender sebagai link ke Beranda di dalam template (JSX tidak bisa dipakai di frontmatter).
function splitLinkParts(text: string) {
	return text
		.split(/(bayarfidyah\.com)/gi)
		.filter((part) => part !== '')
		.map((part) => ({ text: part, isLink: /^bayarfidyah\.com$/i.test(part) }));
}

// Tentukan tujuan link untuk blok "Baca Juga": jika sudah ada href pakai itu,
// jika tidak ada, cocokkan label dengan judul artikel lain agar otomatis mengarah
// ke artikel yang sesuai. Jika tidak ditemukan, arahkan ke halaman Blog.
function resolveNoteHref(label: string, href?: string) {
	if (href) return href;
	const match = blogPosts.find((p) => p.title.trim().toLowerCase() === label.trim().toLowerCase());
	return match ? `/blog/${match.slug}` : '/blog';
}
---

<Layout title={`${post.title} — BayarFidyah.com`} description={post.excerpt}>
	<Navbar />

	<section class="bg-white pt-8 sm:pt-12">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid gap-10 lg:grid-cols-3">
				<!-- Konten Blog -->
				<article class="lg:col-span-2">
					<div data-reveal="zoom" class="aspect-[16/9] w-full overflow-hidden rounded-2xl shadow-sm">
						<img src={post.image} alt={post.title} class="h-full w-full object-cover transition duration-500 hover:scale-105" />
					</div>

					<h1 data-reveal style="--reveal-delay:100ms" class="mt-6 text-2xl font-extrabold leading-tight text-emerald-950 sm:text-3xl">{post.title}</h1>

					<div data-reveal style="--reveal-delay:160ms" class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-slate-100 pb-5 text-sm text-slate-500">
						<a
							href={`/blog?author=${encodeURIComponent(post.author)}`}
							class="flex items-center gap-1.5 font-semibold text-slate-600 transition hover:text-emerald-700"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-emerald-600">
								<circle cx="12" cy="8" r="4" />
								<path stroke-linecap="round" d="M4 20c0-4 3.5-6 8-6s8 2 8 6" />
							</svg>
							{post.author}
						</a>
						<span class="flex items-center gap-1.5">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-emerald-600">
								<rect x="3" y="5" width="18" height="16" rx="2" />
								<path stroke-linecap="round" d="M16 3v4M8 3v4M3 10h18" />
							</svg>
							{post.date}
						</span>
					</div>

					<div class="prose prose-slate mt-6 max-w-none prose-headings:font-extrabold prose-headings:text-emerald-950 prose-a:text-emerald-700 prose-a:font-semibold">
						{post.content.map((block) => {
							if (block.type === 'p') {
								return (
									<p class="leading-relaxed text-slate-700">
										{splitLinkParts(block.text).map((part) =>
											part.isLink ? (
												<a href="/" class="font-semibold text-amber-600 underline decoration-amber-500/50 underline-offset-2 hover:text-amber-500">{part.text}</a>
											) : (
												part.text
											)
										)}
									</p>
								);
							}
							if (block.type === 'h2') {
								return <h2 class="mt-8 text-xl font-extrabold text-emerald-950 sm:text-2xl">{block.text}</h2>;
							}
							if (block.type === 'h3') {
								return <h3 class="mt-6 text-lg font-bold text-emerald-900">{block.text}</h3>;
							}
							if (block.type === 'ul') {
								return (
									<ul class="list-disc space-y-1.5 pl-5 text-slate-700">
										{block.items.map((item) => <li>{item}</li>)}
									</ul>
								);
							}
							if (block.type === 'ol') {
								return (
									<ol class="list-decimal space-y-1.5 pl-5 text-slate-700">
										{block.items.map((item) => <li>{item}</li>)}
									</ol>
								);
							}
							if (block.type === 'quote') {
								return (
									<blockquote class="my-5 rounded-xl border-l-4 border-amber-400 bg-emerald-50 px-5 py-4">
										{block.arabic && <p class="mb-2 text-right text-lg leading-loose text-emerald-900" dir="rtl">{block.arabic}</p>}
										<p class="text-sm italic leading-relaxed text-emerald-900">{block.text}</p>
									</blockquote>
								);
							}
							if (block.type === 'note') {
								return (
									<p class="my-4 rounded-lg bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700">
										Baca Juga:{' '}
										<a href={resolveNoteHref(block.label, block.href)} class="font-semibold text-amber-700 underline hover:text-amber-600">
											{block.label}
										</a>
									</p>
								);
							}
							if (block.type === 'cta') {
								return (
									<p class="my-4 rounded-xl bg-emerald-900 px-5 py-4 text-sm font-medium leading-relaxed text-emerald-50">
										{splitLinkParts(block.text).map((part) =>
											part.isLink ? (
													<a href="/" class="font-semibold text-amber-500 underline decoration-amber-500/60 underline-offset-2 hover:text-amber-400">{part.text}</a>
											) : (
												part.text
											)
										)}
									</p>
								);
							}
							return null;
						})}
					</div>

					<div class="mt-8 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-6 text-sm text-slate-500">
						{post.writer && <span>Penulis: <strong class="text-slate-700">{post.writer}</strong></span>}
						{post.editor && <span>· Editor: <strong class="text-slate-700">{post.editor}</strong></span>}
					</div>

				</article>

				<!-- Sidebar -->
				<aside data-reveal="right">
					<h2 class="text-lg font-extrabold text-emerald-950">Latest Post</h2>
					<div class="mt-4 space-y-4">
						{otherPosts.map((item) => (
							<a href={`/blog/${item.slug}`} class="group flex gap-3 rounded-xl p-2 transition duration-300 hover:-translate-y-0.5 hover:bg-emerald-50">
								<div class="h-16 w-20 shrink-0 overflow-hidden rounded-lg">
									<img src={item.image} alt={item.title} class="h-full w-full object-cover" loading="lazy" />
								</div>
								<p class="text-sm font-semibold leading-snug text-emerald-600 group-hover:text-amber-600">
									{item.title}
								</p>
							</a>
						))}
					</div>
				</aside>
			</div>
		</div>
	</section>

	<Footer showJaminanLayanan={false} />
</Layout>
