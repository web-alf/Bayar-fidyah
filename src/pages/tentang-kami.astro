---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CtaBayar from '../components/CtaBayar.astro';
import Footer from '../components/Footer.astro';

const profil = [
	"Bayarfidyah.com adalah salah satu program Yayasan Alfatihah yang merupakan sebuah lembaga professional berlokasi di Kota Semarang yang bergerak di bidang sosial dan pendidikan. Berdiri semenjak tahun 2016, Yayasan Alfatihah.com telah berkontribusi dalam program-program sosial dan pendidikan untuk menjembatani sekaligus berkontribusi pada kemaslahatan umat banyak. Beragam kegiatan dan pergerakan sosial kini semakin berkembang serta memiliki banyak agenda program.",
	"Beberapa program terbaik Al Fatihah yang terus berkembang sampai saat ini adalah adalah program menghafal Al qur'an di Rumah Tahfidz yang telah memililiki beberapa cabang di Kota Semarang, program pondok pesantren yang terus dibangun di beberapa daerah untuk para pejuang penghafal Al'quran, program pendidikan Al'Quran bagi anak-anak usia dini melalui program Alfatihah School (ALS) dan untuk menjembatani bakat minat di duniapara hafidz dan hafidzah, kami juga menyediakan studio rekaman untuk membumikan Alquran melalui media video.",
];

const misi = [
	'Menggalang kepedulian masyarakat melalui kerja ikhlas, kerja cerdas dan kerja tuntas',
	'Mengaktualisasikan pemberdayaan masyarakat menjadi mandiri dan produktif dengan mensinergikan program pemberdayaan ekonomi, pendidikan, kesehatan, lingkungan dan kebencanaan',
];

const alamat = [
	{ label: 'Kantor Pusat', value: 'Jalan Ngablak Indah II No. 24A Genuk Kota Semarang 50111' },
	{ label: 'Cabang 1 Pedurungan', value: 'Jalan Kalicari 4, No. 15, Kec. Kalicari, Pedurungan Kota Semarang 50198' },
	{ label: 'Cabang 2 Pedurungan', value: 'Jalan Sidomulyo II No. 38 Mukthiharjo Kidul Pedurungan Kota Semarang 50197' },
	{ label: 'Cabang 3 Semarang Barat', value: 'Jalan Pamularsih no. 41B Ruko Kota Semarang 50149' },
];

const dokumentasi = [
	{ src: '/images/dokumentasi%201.png', width: 375, height: 188 },
	{ src: '/images/dokumentasi%202.png', width: 316, height: 194 },
	{ src: '/images/dokumentasi%203.png', width: 379, height: 194 },
	{ src: '/images/dokumetasi%204.png', width: 382, height: 195 },
	{ src: '/images/dokumentasi%205.png', width: 383, height: 193 },
	{ src: '/images/dokumentasi%206.png', width: 384, height: 188 },
	{ src: '/images/dokumentasi%207.png', width: 377, height: 183 },
	{ src: '/images/dokumentasi%208.png', width: 372, height: 191 },
	{ src: '/images/dokumentasi%209.png', width: 378, height: 185 },
	{ src: '/images/dokumentasi%2010.png', width: 384, height: 188 },
	{ src: '/images/dokumentasi%2011.png', width: 384, height: 189 },
	{ src: '/images/dokumentasi%2012.png', width: 376, height: 191 },
];
---

<Layout
	title="Tentang Kami — BayarFidyah.com"
	description="Mengenal lebih dekat Yayasan Alfatihah, lembaga profesional di bidang sosial dan pendidikan yang berkontribusi untuk kemaslahatan umat sejak 2016."
>
	<Navbar />

	<!-- Banner judul -->
	<section class="relative overflow-hidden bg-gradient-to-br from-emerald-900 via-emerald-800 to-emerald-950 py-14 text-center text-white sm:py-20">
		<div class="pointer-events-none absolute inset-0 opacity-10 [background-image:radial-gradient(circle_at_1px_1px,white_1px,transparent_0)] [background-size:24px_24px]"></div>
		<div data-reveal class="relative mx-auto max-w-3xl px-4">
			<h1 class="text-3xl font-extrabold sm:text-4xl">Tentang Kami</h1>
			<p class="mt-3 text-sm text-emerald-100 sm:text-base">
				Amanah mengelola kepedulian umat, berkontribusi untuk kemaslahatan bersama sejak tahun 2016.
			</p>
		</div>
	</section>

	<!-- Profil -->
	<section class="bg-white py-14 sm:py-20">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="rounded-2xl border border-slate-200 p-6 transition duration-300 hover:shadow-md sm:p-10">
				<h2 class="text-2xl font-extrabold text-emerald-950 sm:text-3xl">Profil Yayasan Alfatihah</h2>
				{profil.map((p) => (
					<p class="mt-5 text-sm leading-relaxed text-slate-700 sm:text-base">{p}</p>
				))}
			</div>
		</div>
	</section>

	<!-- Visi, Misi & Alamat -->
	<section class="relative overflow-hidden bg-gradient-to-br from-emerald-900 via-emerald-800 to-emerald-950 py-14 text-white sm:py-20">
		<div class="pointer-events-none absolute inset-0 opacity-10 [background-image:radial-gradient(circle_at_1px_1px,white_1px,transparent_0)] [background-size:24px_24px]"></div>
		<div class="relative mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
			<div data-reveal="left">
				<h3 class="text-lg font-extrabold uppercase tracking-wide text-amber-500">Visi</h3>
				<p class="mt-4 text-sm leading-relaxed text-emerald-50 sm:text-base">
					Menjadi lembaga pendidikan dan sosial yang profesional dan memberdayakan masyarakat.
				</p>

				<h3 class="mt-8 text-lg font-extrabold uppercase tracking-wide text-amber-500">Misi</h3>
				<ul class="mt-4 space-y-3 text-sm leading-relaxed text-emerald-50 sm:text-base">
					{misi.map((item) => (
						<li class="flex items-start gap-2">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
							<span>{item}</span>
						</li>
					))}
				</ul>
			</div>

			<div data-reveal="right">
				<h3 class="text-lg font-extrabold uppercase tracking-wide text-amber-500">Alamat Al Fatihah</h3>
				<div class="mt-4 space-y-4">
					{alamat.map((a) => (
						<div class="border-l-2 border-amber-500/60 pl-4 transition duration-300 hover:border-amber-400 hover:pl-5">
							<p class="text-sm font-bold text-white sm:text-base">{a.label}</p>
							<p class="mt-1 text-sm leading-relaxed text-emerald-100">{a.value}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Dokumentasi Kegiatan -->
	<section class="bg-white py-14 sm:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div data-reveal class="mx-auto mb-10 max-w-2xl text-center">
				<h2 class="text-2xl font-extrabold text-emerald-950 sm:text-3xl">Dokumentasi Kegiatan</h2>
				<p class="mt-3 text-sm text-slate-600">
					Beragam kegiatan sosial dan pendidikan yang telah dijalankan Yayasan Alfatihah bersama para
					penerima manfaat.
				</p>
			</div>

			<div id="dokumentasi-gallery" class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
				{dokumentasi.map((d, i) => (
					<a
						href={d.src}
						data-pswp-width={d.width}
						data-pswp-height={d.height}
						data-caption={`Dokumentasi Kegiatan ${i + 1}`}
						class="group relative block aspect-[4/3] w-full cursor-zoom-in overflow-hidden rounded-2xl shadow-sm ring-1 ring-slate-100"
					>
						<img
							src={d.src}
							alt={`Dokumentasi kegiatan Yayasan Alfatihah ${i + 1}`}
							class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
							loading="lazy"
						/>
						<span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-emerald-950/0 transition group-hover:bg-emerald-950/20">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-8 w-8 text-white opacity-0 transition group-hover:opacity-100">
								<circle cx="11" cy="11" r="7"></circle>
								<path d="m21 21-4.35-4.35"></path>
								<path d="M11 8v6M8 11h6"></path>
							</svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<CtaBayar />
	<Footer showJaminanLayanan={false} />
</Layout>

<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import 'photoswipe/style.css';

	const lightbox = new PhotoSwipeLightbox({
		gallery: '#dokumentasi-gallery',
		children: 'a',
		pswpModule: () => import('photoswipe'),
		padding: { top: 20, bottom: 40, left: 20, right: 20 },
		bgOpacity: 0.9,
	});

	// Ikon expand (masuk fullscreen) & collapse (keluar fullscreen)
	const ICON_EXPAND =
		'<path d="M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>';
	const ICON_COLLAPSE =
		'<path d="M9 4v4a1 1 0 0 1-1 1H4M15 4v4a1 1 0 0 0 1 1h4M15 20v-4a1 1 0 0 1 1-1h4M9 20v-4a1 1 0 0 0-1-1H4" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>';
	// Ikon share (panah sederhana)
	const ICON_SHARE =
		'<path d="M8 16 16 8M16 8H9M16 8v7" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>';

	lightbox.on('uiRegister', function () {
		// Caption di bawah foto (mengikuti data-caption pada tiap <a>)
		lightbox.pswp.ui.registerElement({
			name: 'custom-caption',
			order: 9,
			isButton: false,
			appendTo: 'root',
			onInit: (el) => {
				el.className = 'pswp__custom-caption';
				lightbox.pswp.on('change', () => {
					const currSlideElement = lightbox.pswp.currSlide.data.element;
					el.textContent = currSlideElement?.getAttribute('data-caption') || '';
				});
			},
		});

		// Tombol Fullscreen (masuk/keluar layar penuh)
		lightbox.pswp.ui.registerElement({
			name: 'fullscreen-button',
			ariaLabel: 'Perbesar Layar Penuh',
			order: 8,
			isButton: true,
			html: {
				isCustomSVG: true,
				inner: ICON_EXPAND,
				outlineID: 'pswp__icn-fullscreen',
			},
			onInit: (el) => {
				const setIcon = () => {
					const isFs = Boolean(document.fullscreenElement);
					const svg = el.querySelector('svg');
					if (svg) svg.innerHTML = isFs ? ICON_COLLAPSE : ICON_EXPAND;
					el.setAttribute('aria-label', isFs ? 'Keluar Layar Penuh' : 'Perbesar Layar Penuh');
				};
				document.addEventListener('fullscreenchange', setIcon);
			},
			onClick: () => {
				const pswpEl = lightbox.pswp.element;
				if (!document.fullscreenElement) {
					pswpEl?.requestFullscreen?.().catch(() => {});
				} else {
					document.exitFullscreen?.().catch(() => {});
				}
			},
		});

		// Tombol Share (Web Share API native, fallback salin tautan)
		lightbox.pswp.ui.registerElement({
			name: 'share-button',
			ariaLabel: 'Bagikan',
			order: 15,
			isButton: true,
			html: {
				isCustomSVG: true,
				inner: ICON_SHARE,
				outlineID: 'pswp__icn-share',
			},
			onClick: async () => {
				const slide = lightbox.pswp.currSlide;
				const pageUrl = window.location.href;
				const caption =
					slide.data.element?.getAttribute('data-caption') || 'Dokumentasi Kegiatan Yayasan Alfatihah';

				if (navigator.share) {
					try {
						await navigator.share({ title: caption, text: caption, url: pageUrl });
					} catch (err) {
						// dibatalkan pengguna, abaikan
					}
				} else if (navigator.clipboard) {
					try {
						await navigator.clipboard.writeText(pageUrl);
						showToast('Tautan disalin ke clipboard');
					} catch (err) {
						showToast('Gagal menyalin tautan');
					}
				}
			},
		});
	});

	// Toast kecil untuk notifikasi fallback share
	function showToast(message) {
		const toast = document.createElement('div');
		toast.className = 'pswp__toast';
		toast.textContent = message;
		document.body.appendChild(toast);
		setTimeout(() => toast.classList.add('pswp__toast--visible'), 10);
		setTimeout(() => {
			toast.classList.remove('pswp__toast--visible');
			setTimeout(() => toast.remove(), 300);
		}, 2200);
	}

	lightbox.init();
</script>

<style is:global>
	.pswp__custom-caption {
		position: absolute;
		bottom: 16px;
		left: 0;
		right: 0;
		margin: 0 auto;
		width: max-content;
		max-width: 90%;
		padding: 6px 16px;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.5);
		color: #fff;
		font-size: 14px;
		font-weight: 600;
		text-align: center;
		z-index: 1500;
	}

	.pswp__toast {
		position: fixed;
		bottom: 32px;
		left: 50%;
		transform: translate(-50%, 12px);
		z-index: 3000;
		padding: 10px 20px;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.85);
		color: #fff;
		font-size: 13px;
		font-weight: 600;
		opacity: 0;
		transition: opacity 0.25s ease, transform 0.25s ease;
		pointer-events: none;
	}

	.pswp__toast--visible {
		opacity: 1;
		transform: translate(-50%, 0);
	}
</style>
