---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { blogPosts } from '../data/blogPosts';

// Catatan: halaman ini dirender statis (output: static), sehingga query string
// ?author=... tidak bisa dibaca saat build. Semua artikel tetap dirender di HTML
// (dengan atribut data-author), lalu disaring di sisi klien lewat skrip di bawah
// berdasarkan parameter ?author= pada URL saat halaman dibuka di browser.
const articles = blogPosts;
---

<Layout title="Blog — BayarFidyah.com" description="Blog dan panduan seputar fidyah puasa bersama Yayasan Al-Fatihah.">
	<Navbar />

	<section class="bg-emerald-950 py-14 text-center text-white sm:py-20">
		<div data-reveal class="mx-auto max-w-3xl px-4">
			<h1 class="text-3xl font-extrabold sm:text-4xl">Blog Terbaru</h1>
			<p class="mt-3 text-sm text-emerald-100 sm:text-base">
				Panduan, hukum, dan informasi seputar fidyah puasa yang perlu Anda ketahui.
			</p>
			<p id="author-filter-notice" class="mt-4 hidden text-sm text-emerald-100">
				Menampilkan artikel dari <strong id="author-filter-name" class="text-white"></strong>
			</p>
		</div>
	</section>

	<section class="bg-white py-14 sm:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<p id="author-filter-empty" class="hidden text-center text-sm text-slate-500">
				Belum ada artikel dari penulis ini.
			</p>
			<div id="blog-grid" class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
				{articles.map((post, i) => (
					<a
						href={`/blog/${post.slug}`}
						data-author={post.author}
						data-reveal
						style={`--reveal-delay:${(i % 3) * 110}ms`}
						class="group rounded-2xl shadow-sm ring-1 ring-slate-100 transition duration-300 hover:-translate-y-1 hover:shadow-md"
					>
						<article>
							<div class="relative aspect-[16/10] w-full overflow-hidden rounded-t-2xl">
								<img
									src={post.image}
									alt={post.title}
									class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
									loading="lazy"
								/>
								<span class="absolute right-3 top-3 rounded-full bg-emerald-950/70 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-white backdrop-blur-sm">
									Blog
								</span>
							</div>

							<div class="relative rounded-b-2xl bg-white px-5 pb-5 pt-10">
								<div class="absolute -top-8 left-5 h-14 w-14 overflow-hidden rounded-full bg-white shadow-md ring-4 ring-white">
									{post.authorPhoto ? (
										<img src={post.authorPhoto} alt={post.author} class="h-full w-full object-cover" loading="lazy" />
									) : (
										<span class="flex h-full w-full items-center justify-center">
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7 text-slate-300">
												<path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 1.5c-3.59 0-8 1.79-8 4.5v1.5a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V18c0-2.71-4.41-4.5-8-4.5Z" />
											</svg>
										</span>
									)}
								</div>

								<p class="text-xs font-semibold uppercase tracking-wide text-amber-500">{post.date}</p>
								<h2 class="mt-2 text-lg font-bold text-emerald-950 group-hover:text-emerald-700">{post.title}</h2>
								<p class="mt-2 text-sm leading-relaxed text-slate-600">{post.excerpt}</p>
								<span class="mt-3 inline-flex items-center gap-1 text-xs font-extrabold uppercase tracking-wide text-emerald-600 group-hover:text-amber-600">
									Baca Selengkapnya
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="h-3 w-3">
										<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
									</svg>
								</span>
							</div>
						</article>
					</a>
				))}
			</div>
		</div>
	</section>

	<Footer showJaminanLayanan={false} />
</Layout>

<script>
	const params = new URLSearchParams(window.location.search);
	const authorFilter = params.get('author')?.trim();

	if (authorFilter) {
		const cards = document.querySelectorAll<HTMLAnchorElement>('#blog-grid > a');
		let visibleCount = 0;

		cards.forEach((card) => {
			const cardAuthor = card.dataset.author ?? '';
			const matches = cardAuthor.toLowerCase() === authorFilter.toLowerCase();
			card.style.display = matches ? '' : 'none';
			if (matches) visibleCount += 1;
		});

		const notice = document.getElementById('author-filter-notice');
		const nameEl = document.getElementById('author-filter-name');
		const emptyEl = document.getElementById('author-filter-empty');

		if (notice && nameEl) {
			nameEl.textContent = authorFilter;
			notice.classList.remove('hidden');
		}

		if (emptyEl && visibleCount === 0) {
			emptyEl.classList.remove('hidden');
		}
	}
</script>
