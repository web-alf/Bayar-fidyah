---
const manfaat = [
	'Manfaat Membayar Fidyah',
	'Menjalankan Aturan & Syariat Islam',
	'Keringanan Hukum Bagi Orang Yang Tidak Mampu Berpuasa',
	'Menggembirakan Bagi Para Fakir Miskin',
	'Mengajarkan Peduli Terhadap Sesama',
	'Mendidik Untuk Jujur Terhadap Diri Sendiri',
];

const whyUs = [
	{
		title: 'Sesuai Akad',
		desc: 'Akad Yang Baik Harus DIsediakan Wadah Yang Sesuai Juga Sah',
		icon: 'handshake',
	},
	{
		title: 'Terpercaya',
		desc: 'Semua Menjadi Lebih Baik Dengan Kepercayaan & Kejujuran Bersama',
		icon: 'badge',
	},
	{
		title: 'Resmi',
		desc: 'Legalitas Merupakan Acuan Dasar Untuk Kami Tetap Eksis Bagi Umat',
		icon: 'check',
	},
	{
		title: 'Akuntable',
		desc: 'Pembukuan Jelas Serta Penghitungan Akurat Menjadi Komitmen Kami',
		icon: 'doc',
	},
];
---

<section id="penyaluran" class="bg-white py-14 sm:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<!-- Manfaat -->
		<div data-reveal class="text-center">
			<h2 class="text-2xl font-extrabold text-emerald-950 sm:text-3xl">Manfaat Membayar Fidyah</h2>
		</div>
		<div data-reveal style="--reveal-delay:120ms" class="mx-auto mt-6 max-w-3xl rounded-2xl bg-emerald-50/60 p-6 ring-1 ring-emerald-100 transition duration-300 hover:shadow-md sm:p-8">
			<ul class="space-y-4 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-4 sm:space-y-0">
				{manfaat.map((item) => (
					<li class="flex items-start gap-3">
						<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
								<path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
							</svg>
						</span>
						<span class="text-sm font-medium text-emerald-950">{item}</span>
					</li>
				))}
			</ul>
		</div>

		<!-- Kenapa di BayarFidyah.com -->
		<div data-reveal class="mt-14 text-center">
			<h3 class="text-xl font-extrabold text-emerald-950 sm:text-2xl">
				Mengapa Harus Menunaikan Fidyah di <span class="text-amber-500">Bayarfidyah.com?</span>
			</h3>
		</div>
		<div class="mx-auto mt-7 grid max-w-4xl grid-cols-2 gap-x-4 gap-y-7 sm:grid-cols-4">
			{whyUs.map((item, index) => (
				<div data-reveal="zoom" style={`--reveal-delay:${index * 90}ms`} class="flex flex-col items-center gap-3 px-1 text-center transition duration-300 hover:-translate-y-1">
					<span class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-600 text-white shadow-sm transition-transform duration-300">
						{item.icon === 'handshake' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6.5 w-6.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M2.5 11.5 6 8l3 2 2.5-2 3 2.2 3.5-2.7" />
								<path stroke-linecap="round" stroke-linejoin="round" d="m2.5 11.5 4 4.5a2 2 0 0 0 2.8.2L10 15" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.5 9.5 17 14a2 2 0 0 1-2.8.2L11 11.5" />
							</svg>
						)}
						{item.icon === 'badge' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6.5 w-6.5">
								<circle cx="12" cy="9" r="5.5" />
								<path stroke-linecap="round" stroke-linejoin="round" d="m8.5 14-1.5 6.5L12 18l5 2.5L15.5 14" />
							</svg>
						)}
						{item.icon === 'check' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6.5 w-6.5">
								<circle cx="12" cy="12" r="8.5" />
								<path stroke-linecap="round" stroke-linejoin="round" d="m8 12.5 2.8 2.8L16.5 9" />
							</svg>
						)}
						{item.icon === 'doc' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6.5 w-6.5">
								<rect x="5" y="4" width="14" height="16" rx="1.5" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M8.5 9h7M8.5 12.5h7M8.5 16h4.5" />
							</svg>
						)}
					</span>
					<div>
						<p class="text-sm font-bold leading-snug text-emerald-950">{item.title}</p>
						<p class="mt-1.5 text-xs leading-relaxed text-slate-500">{item.desc}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
