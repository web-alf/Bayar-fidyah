---
const trustPoints = [
	{
		line1: 'Donasi',
		line2: 'Aman',
		icon: 'shield',
	},
	{
		line1: 'Pelayanan',
		line2: 'Terbaik',
		icon: 'heart',
	},
	{
		line1: 'Privasi',
		line2: 'Dilindungi',
		icon: 'lock',
	},
];
---

<section id="bayar" class="bg-emerald-50/70 py-14 sm:py-20">
	<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
		<h2 data-reveal class="text-2xl font-extrabold leading-tight text-emerald-950 sm:text-3xl">
			JANGAN TUNDA KEWAJIBAN
			<span class="block text-orange-500">TUNAIKAN FIDYAH SEKARANG!</span>
		</h2>
		<p data-reveal style="--reveal-delay:80ms" class="mt-3 text-sm font-medium text-emerald-900/70 sm:text-base">
			Salurkan Untuk Mereka yang Berhak &amp; Tepat Sasaran
		</p>

		<div data-reveal style="--reveal-delay:160ms" class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-4 sm:gap-x-7">
			{trustPoints.map((point, index) => (
				<>
					<div class="flex items-center gap-2.5">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 shrink-0 text-emerald-900">
							{point.icon === 'shield' && (
								<path d="M12 2.5 4.5 5.5v6c0 5 3.3 8.3 7.5 10 4.2-1.7 7.5-5 7.5-10v-6L12 2.5Z" />
							)}
							{point.icon === 'heart' && (
								<>
									<path d="M12 7.5a3 3 0 1 0-5.3 1.9c.4.5 1 1 1.8 1.6L12 14l3.5-3c.8-.6 1.4-1.1 1.8-1.6A3 3 0 1 0 12 7.5Z" />
									<circle cx="9" cy="5" r="2" />
								</>
							)}
							{point.icon === 'lock' && (
								<>
									<path d="M12 2.5a4 4 0 0 0-4 4v2.25H7A1.5 1.5 0 0 0 5.5 10.25v8.25A1.5 1.5 0 0 0 7 20h10a1.5 1.5 0 0 0 1.5-1.5v-8.25A1.5 1.5 0 0 0 17 8.75h-2.5V6.5a2.5 2.5 0 0 0-5 0 .75.75 0 0 1-1.5 0 4 4 0 0 1 4-4Z" />
									<circle cx="12" cy="14" r="1.6" fill="white" />
								</>
							)}
						</svg>
						<span class="text-left text-sm font-bold leading-tight text-emerald-950">
							{point.line1}<br />{point.line2}
						</span>
					</div>
					{index < trustPoints.length - 1 && <span class="hidden h-10 w-px bg-slate-200 sm:block" />}
				</>
			))}
		</div>

		<a
			href="https://wa.me/628112704113"
			data-reveal="zoom"
			style="--reveal-delay:240ms"
			class="group mt-8 inline-flex items-center gap-2.5 rounded-full bg-orange-500 px-7 py-3.5 text-base font-bold text-white shadow-lg shadow-orange-500/30 transition duration-300 hover:-translate-y-0.5 hover:bg-orange-400 hover:shadow-xl hover:shadow-orange-500/40"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 8.5c-1.2-2-4.8-2-5.8.5-1 2.5 1.3 4.5 5.8 8 4.5-3.5 6.8-5.5 5.8-8-1-2.5-4.6-2.5-5.8-.5Z" />
			</svg>
			Tunaikan Fidyah Sekarang
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1">
				<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
			</svg>
		</a>
	</div>
</section>
