	{ src: '/images/logo%20bf%203.png', alt: 'Rumah Tahfidz Al-Fatihah' },
	{ src: '/images/logo%20bf%204.png', alt: 'Alfatihah Studio' },
	{ src: '/images/logo%20bf%205.png', alt: 'Pesantren Alfatihah' },
	{ src: '/images/logo%20bf%206.png', alt: 'Alfatihah Day Care' },
	{ src: '/images/lofo%20bf%207.png', alt: 'Alfatihah Boarding School' },
	{ src: '/images/logo%20bf%208.png', alt: 'Doa Tanpa Suara - Doa Santri Tunarungu' },
	{ src: '/images/logo%20bf%209.png', alt: 'Ambulance Al-Fatihah' },
	{ src: '/images/logo%20bf%2010.png', alt: 'Nasi Santri' },
