---
const trustPoints = [
	{
		title: 'Aman & Terpercaya',
		desc: 'Dikelola oleh lembaga resmi',
		icon: 'shield',
	},
	{
		title: 'Disalurkan Tepat Sasaran',
		desc: 'Untuk yang berhak menerima',
		icon: 'target',
	},
	{
		title: 'Mudah & Praktis',
		desc: 'Cukup bayar lewat online',
		icon: 'click',
	},
	{
		title: 'Transparan',
		desc: 'Laporan penyaluran yang jelas',
		icon: 'doc',
	},
];
---

<section id="beranda" class="relative overflow-hidden bg-gradient-to-br from-emerald-900 via-emerald-800 to-emerald-950 text-white">
	<div class="pointer-events-none absolute inset-0 opacity-10 [background-image:radial-gradient(circle_at_1px_1px,white_1px,transparent_0)] [background-size:24px_24px]"></div>

	<div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-8 lg:px-8 lg:py-20">
		<div class="text-center lg:text-left">
			<span data-reveal="fade" style="--reveal-delay:0ms" class="inline-flex items-center gap-2 rounded-full bg-orange-500/15 px-4 py-1.5 text-xs font-semibold text-orange-500 ring-1 ring-orange-500/30">
				Menyambut Bulan Mulia Penuh Berkah bersama Alfatihah
			</span>

			<h1 data-reveal style="--reveal-delay:100ms" class="mt-5 text-3xl font-extrabold leading-tight sm:text-4xl lg:text-5xl">
				Segera Tunaikan Fidyah
				<span class="block text-orange-500">& Gapai Pahala Berlimpah!</span>
			</h1>
			<p data-reveal style="--reveal-delay:180ms" class="mt-3 text-xl font-bold text-white/90 sm:text-2xl">Tuntaskan Hutang Puasa</p>

			<p data-reveal style="--reveal-delay:260ms" class="mx-auto mt-4 max-w-xl text-base text-emerald-100 lg:mx-0">
				Menyambut Bulan Ramadhan Penuh Berkah dan menjadi bermanfaat untuk sesama bersama Alfatihah.
			</p>

			<div data-reveal style="--reveal-delay:340ms" class="mt-7 flex justify-center lg:justify-start">
				<a
					href="https://wa.me/628112704113"
					class="group inline-flex items-center gap-2 rounded-full bg-orange-500 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition duration-300 hover:-translate-y-0.5 hover:bg-orange-400 hover:shadow-lg hover:shadow-orange-500/40"
				>
					Bayar Fidyah Sekarang
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
					</svg>
				</a>
			</div>
		</div>

		<div data-reveal="zoom" style="--reveal-delay:150ms" class="relative mx-auto w-full max-w-md lg:max-w-full">
			<div class="relative overflow-hidden rounded-3xl bg-white/5 p-2 ring-1 ring-white/10 backdrop-blur transition duration-500 hover:ring-white/20">
				<img
					src="/images/hero.jpg"
					alt="Ilustrasi berbagi untuk sesama saat membayar fidyah puasa"
					class="aspect-[4/3] w-full rounded-2xl object-cover transition duration-500 hover:scale-[1.02]"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>

	<div class="relative border-t border-white/10 bg-emerald-950/60">
		<div class="mx-auto grid max-w-7xl grid-cols-2 gap-4 px-4 py-8 sm:px-6 lg:grid-cols-4 lg:gap-6 lg:px-8">
			{trustPoints.map((point, index) => (
				<div data-reveal style={`--reveal-delay:${index * 100}ms`} class="flex items-start gap-3 rounded-xl bg-white/5 p-4 ring-1 ring-white/5 transition duration-300 hover:-translate-y-1 hover:bg-white/10">
					<span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-500/15 text-orange-500 transition-transform duration-300">
						{point.icon === 'shield' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 3 4.5 6v6c0 4.5 3 7.5 7.5 9 4.5-1.5 7.5-4.5 7.5-9V6L12 3Z" />
							</svg>
						)}
						{point.icon === 'target' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
								<circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="4" /><circle cx="12" cy="12" r="0.5" />
							</svg>
						)}
						{point.icon === 'click' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="m9.5 9.5 7 2.5-3 1.3-1.3 3-2.7-6.8Z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v3m2.5-1.5L8 7M4 10H7" />
							</svg>
						)}
						{point.icon === 'doc' && (
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 6 20V4a.5.5 0 0 1 .5-.5Z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 15.5h6" />
							</svg>
						)}
					</span>
					<div>
						<p class="text-sm font-bold text-white leading-tight">{point.title}</p>
						<p class="text-xs text-emerald-200/80 leading-snug">{point.desc}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
